#!/usr/bin/env bash
# =============================================================================
# config.env — Poco C65 Migration Configuration
# Edit these values before running migrate.sh
# =============================================================================

# ── Device ────────────────────────────────────────────────────────────────────
# Auto-detected from ADB if left empty (gust = India, gale = Global)
DEVICE_CODENAME=""

# ADB serial number — auto-detected if only one device is connected
ADB_SERIAL=""

# ── Backup destination ────────────────────────────────────────────────────────
# Where to store the full device backup (needs ~120GB free)
BACKUP_DIR="${HOME}/poco_c65_backup"

# ── ROM selection ─────────────────────────────────────────────────────────────
# LineageOS 21 (Android 14) — privacy-first, no Google
# Builds index for gust: https://download.lineageos.org/devices/gust/builds
# Builds index for gale: https://download.lineageos.org/devices/gale/builds
LINEAGEOS_VERSION="21"
LINEAGEOS_VARIANT="gust"       # set to "gale" if you have the Global variant

# Direct download URLs — update to latest build from the LineageOS site above
LINEAGEOS_ZIP_URL="https://github.com/crdroidandroid/android_device_xiaomi_gust/releases/download/placeholder/lineage-21.0-UNOFFICIAL-gust.zip"
LINEAGEOS_ZIP_SHA256=""        # paste SHA256 hash here (or leave blank to skip verify)

# ── microG (replaces Google Play Services without Google) ─────────────────────
# NanoDroid microG package — provides Play Services API without Google telemetry
MICROG_ZIP_URL="https://github.com/Nanolx/NanoDroid/releases/download/placeholder/NanoDroid-microG-24.0.0.zip"
MICROG_ZIP_SHA256=""

# ── TWRP Recovery ─────────────────────────────────────────────────────────────
# TWRP for gale/gust — same hardware, shared recovery image
# Source: https://dl.twrp.me/gale/ or XDA thread
TWRP_IMG_URL="https://dl.twrp.me/gale/twrp-3.7.0_12-0-gale.img.html"
TWRP_IMG_SHA256=""

# ── Stock ROM (for restore/rollback) ─────────────────────────────────────────
# Download from: https://xiaomifirmwareupdater.com/miui/gust/
# Or:            https://xmfirmwareupdater.com/hyperos/gust/
STOCK_ROM_ZIP_URL=""           # fill in to enable full factory restore
STOCK_ROM_ZIP_SHA256=""

# ── Timing ────────────────────────────────────────────────────────────────────
# Seconds to wait for device to reboot between phases
REBOOT_WAIT_SECS=60

# Seconds to wait for first LineageOS boot (it's slow on first run)
FIRST_BOOT_WAIT_SECS=180

# ── Flags ─────────────────────────────────────────────────────────────────────
# Set to "true" to skip download and use files already in downloads/
SKIP_DOWNLOAD=false

# Set to "true" to skip SHA256 verification (not recommended)
SKIP_CHECKSUM=false

# Set to "true" to skip the data wipe step (NOT recommended — leaves MIUI cruft)
SKIP_WIPE=false
